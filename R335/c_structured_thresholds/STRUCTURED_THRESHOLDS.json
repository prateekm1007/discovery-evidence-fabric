  "authority": "CEO R335-C — structured numeric thresholds. No more heuristic text extraction.",
  "timestamp": "2026-08-26T14:10:00Z",

  "problem": "R333 used re.findall(r'[\\d.]+', rule_text) and took the last number. This is unsafe — rules contain multiple numbers (pass threshold, control threshold, sample size, percentages). R333 integration test failed on P-04 because pass_rule='>=80% Aβ42 in 72h; control <10%' has two numbers (80 and 10).",

  "fix": "Add structured threshold fields to every canonical experiment contract. The prose rule remains for humans. The structured fields control deterministic execution.",

  "structured_threshold_schema": {
    "metric": "Name of the measured quantity (e.g., 'ICP_excursion_reduction_pct', 'Aβ42_clearance_pct', 'valve_response_time_s')",
    "units": "Unit of measurement (e.g., '%', 'mmHg', 'seconds', 'mL/min')",
    "direction": "HIGHER_IS_BETTER or LOWER_IS_BETTER",
    "pass_threshold": "Numeric value above (or below) which the experiment PASSES",
    "fail_threshold": "Numeric value above (or below) which the experiment FAILS",
    "confidence_level": "Required confidence level (e.g., 0.95 for 95% CI)",
    "statistical_test": "How to compute the CI (e.g., 'normal_approximation', 'bootstrap', 'exact_binomial')",
    "threshold_provenance": "Why this threshold (e.g., 'Published clinical threshold (AANS)', 'Engineering design spec', 'FDA guidance')",
    "threshold_evidence_class": "OBSERVED / SOURCE_DERIVED / MODELLED / ESTIMATED / ASSUMED"
  },

