{
  "fabric_version": "2",
  "fabric_name": "RETRIEVAL_FABRIC_V2",
  "version_note": "Multi-source open/free retrieval fabric (R409). V1 = Europe PMC + OpenAlex (a2/retrieve.py, byte-unchanged, historical corpus immutable). V2 treats Europe PMC + OpenAlex as two nodes among materially different open source families. The 13 CEO-directive provider-policy fields live in discovery_fabric/source_registry/registry.py (the single authority for provider policy, Art. X); this file is the authority for FABRIC fields (families, lanes, lineage, coverage classes) and is validated by tests to cross-reference registered source_ids.",
  "independence_model": {
    "rule": "A family is an independence cluster. Two families are CORRELATED for a run when (a) they declare a shared metadata upstream in derives_from AND (b) the run measured actual canonical-record overlap between them. Correlated families merge into one independent cluster (union-find). Independence is measured, never assumed (Art. XXI.7).",
    "families": {
      "biomedical_pubmed_line": "PubMed/PMC-centered biomedical literature (Europe PMC's own fulltext+metadata universe)",
      "scholarly_index_openalex": "OpenAlex scholarly index (own citation graph; metadata harvested from Crossref/PubMed/MAG)",
      "scholarly_graph_s2": "Semantic Scholar academic graph (own citation graph + recommendations; metadata harvested from Crossref/PubMed/arXiv/MAG)",
      "doi_registrant_crossref": "Crossref DOI registration agency (publisher-deposited records - ORIGIN for a large share of scholarly metadata)",
      "doi_registrant_datacite": "DataCite DOI registration agency (repository/datacentre-deposited records - theses, datasets, Zenodo, institutional repositories)",
      "oa_journal_registry": "DOAJ (journal/article applications submitted directly by journals - own admission pipeline)",
      "oa_location_service": "Unpaywall (own measurement of legally-open full-text locations for known DOIs)",
      "repository_aggregator_openaire": "OpenAIRE aggregation of institutional/subject repositories",
      "repository_aggregator_core": "CORE aggregation (independent harvest of repositories)",
      "preprint_origin": "arXiv preprint server (origin server for preprints)",
      "patent_index_google": "Google Patents index (patent universe: EPO/USPTO/WIPO bulk data - disjoint from the scholarly bibliographic universe)",
      "patent_office_epo": "EPO Open Patent Services (origin patent office)"
    },
    "note": "The same underlying record discovered via Crossref, OpenAlex and Semantic Scholar counts as ONE record with THREE indexing sources - never three independent discoveries (Art. XXI.7: 'independent universes' means different primary sources, not different queries to overlapping databases)."
  },
  "evidence_lanes": [
