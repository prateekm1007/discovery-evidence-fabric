{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "P-01 External Validation Result Submission",
  "type": "object",
  "required": ["package_id", "lab_id", "validation_date", "protocol_version", "runs"],
  "properties": {
    "package_id": {"const": "P-01"},
    "lab_id": {"type": "string", "description": "Unique identifier for the validating lab (or 'anonymous' if lab prefers anonymity)"},
    "validation_date": {"type": "string", "format": "date"},
    "protocol_version": {"const": "1.0.0"},
    "frozen_design_hash_verified": {"type": "boolean", "description": "True if all SHA-256 hashes in frozen_design.json matched received files"},
    "reproducibility_check_passed": {"type": "boolean"},
    "runs": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["run_id", "scenario", "seed", "duration_hours", "metrics", "acceptance_criteria_evaluation"],
        "properties": {
          "run_id": {"type": "string", "description": "Blinded ID assigned by lab data manager"},
          "scenario": {"type": "string", "enum": ["healthy", "mild_1_of_4", "adversarial_2_of_4", "catastrophic_4_of_4", "sensor_failure", "actuator_failure"]},
          "seed": {"type": "integer", "minimum": 42, "maximum": 46},
          "duration_hours": {"type": "number", "description": "Actual duration of run (target: 24.0)"},
          "metrics": {
            "type": "object",
            "required": ["P_ICP_peak_mmhg", "P_ICP_min_mmhg", "P_ICP_mean_mmhg", "INV2_violation_events", "INV2_violation_total_sec", "isolation_count", "predictor_lead_time_sec_avg", "predictor_lead_time_sec_min", "survival", "fail_safe_events"],
            "properties": {
              "P_ICP_peak_mmhg": {"type": "number"},
              "P_ICP_min_mmhg": {"type": "number"},
              "P_ICP_mean_mmhg": {"type": "number"},
              "INV2_violation_events": {"type": "integer"},
              "INV2_violation_total_sec": {"type": "number"},
              "isolation_count": {"type": "integer"},
              "predictor_lead_time_sec_avg": {"type": ["number", "null"]},
              "predictor_lead_time_sec_min": {"type": ["number", "null"]},
              "survival": {"type": "boolean"},
              "fail_safe_events": {"type": "integer"}
            }
          },
          "acceptance_criteria_evaluation": {
            "type": "object",
            "required": ["AC-01", "AC-02", "AC-03", "AC-04", "AC-05", "AC-06"],
            "properties": {
              "AC-01": {"type": "object", "required": ["pass", "evidence"], "properties": {"pass": {"type": "boolean"}, "evidence": {"type": "string"}}},
              "AC-02": {"type": "object", "required": ["pass", "evidence"], "properties": {"pass": {"type": "boolean"}, "evidence": {"type": "string"}}},
              "AC-03": {"type": "object", "required": ["pass", "evidence"], "properties": {"pass": {"type": "boolean"}, "evidence": {"type": "string"}}},
              "AC-04": {"type": "object", "required": ["pass", "evidence"], "properties": {"pass": {"type": "boolean"}, "evidence": {"type": "string"}}},
              "AC-05": {"type": "object", "required": ["pass", "evidence"], "properties": {"pass": {"type": "boolean"}, "evidence": {"type": "string"}}},
              "AC-06": {"type": "object", "required": ["pass", "evidence"], "properties": {"pass": {"type": "boolean"}, "evidence": {"type": "string"}}}
            }
          },
          "anomalies": {"type": "array", "items": {"type": "string"}, "description": "Any unexpected behavior, protocol deviations, or equipment issues"},
          "raw_data_path": {"type": "string", "description": "Path or URL to raw sensor data file"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overall_verdict", "per_scenario_verdict"],
      "properties": {
        "overall_verdict": {"type": "string", "enum": ["PASS", "FAIL", "PARTIAL"]},
        "per_scenario_verdict": {
          "type": "object",
          "properties": {
            "healthy": {"type": "string", "enum": ["PASS", "FAIL"]},
            "mild_1_of_4": {"type": "string", "enum": ["PASS", "FAIL"]},
            "adversarial_2_of_4": {"type": "string", "enum": ["PASS", "FAIL"]},
            "catastrophic_4_of_4": {"type": "string", "enum": ["PASS", "FAIL"]},
            "sensor_failure": {"type": "string", "enum": ["PASS", "FAIL"]},
            "actuator_failure": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        }
      }
    },
    "lab_comments": {"type": "string", "description": "Free-text comments from the lab"}
  }
}
