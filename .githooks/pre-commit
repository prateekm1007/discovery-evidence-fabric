#!/bin/sh
# pre-commit — F21 integrity guard (R11, 2026-11-14).
#
# Every commit made by this clone passes the audit-branch guard: no
# builder commits to audit/* branches, no builder edits to auditor-
# namespace files. Operator override: AUDIT_NAMESPACE_UNLOCK=1.
#
# Discovery: if the guard script itself is missing (deleted, botched
# checkout), FAIL CLOSED — an absent guard must not silently admit
# auditor-namespace edits (Art. XVII).
# R39 fix (found by the F53 refusal-path test): `exec` REPLACES the
# process — everything after it was dead code and the marker check
# never ran. Run the guard and propagate its failure instead.
python3 "$(dirname "$0")/../discovery_fabric/audit_branch_guard.py" || exit $?

# F53 (AM36 D3): conflict markers are blocked at COMMIT time, not only
# caught before push — an added line in the staged diff must never open
# or close a merge-conflict block. Exact-7 tokens only (audited: no
# tracked line matches, so false positives are none); --no-verify is
# the typed escape and must be disclosed in the commit message.
if git diff --cached -U0 --no-color |
   grep -qE '^\+(<{7}($|[ ])|={7}$|>{7}($|[ ]))'; then
  echo "pre-commit: CONFLICT MARKERS found in the staged diff — commit refused (F53/AM36 D3; resolve the merge or use --no-verify and disclose it in the commit message)" >&2
  exit 1
fi

# R40b (c-0054): every STAGED *.json must parse — the R40 round record
# landed as INVALID JSON (Python-literal style) because the R39b
# per-commit JSON-validation lesson was session-local discipline and
# did not bind the other session (the F32/F52/F53 class, 5th
# instance). Validating the INDEX version (git show :file) so the
# check reads exactly what would be committed. --no-verify is the
# typed escape and must be disclosed in the commit message.
status=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if ! git show ":$f" | python3 -m json.tool >/dev/null 2>&1; then
    echo "pre-commit: $f is not valid JSON — commit refused (c-0054; fix the record or use --no-verify and disclose it in the commit message)" >&2
    status=1
  fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR -- '*.json')
EOF
[ "$status" -eq 0 ] || exit 1
