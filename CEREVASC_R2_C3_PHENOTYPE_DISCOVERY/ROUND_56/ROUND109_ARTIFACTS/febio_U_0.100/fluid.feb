<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="2.5">
<Module type="fluid"/>
<Control>
<analysis type="static"/>
<time_steps>1</time_steps>
<step_size>1.0</step_size>
<max_refs>15</max_refs>
<max_ups>10</max_ups>
<dtol>0.001</dtol>
<etol>0.01</etol>
<rtol>0.001</rtol>
<lstol>0.9</lstol>
<qnmethod>BFGS</qnmethod>
<rhoi>-1</rhoi>
</Control>
<Material>
<material id="1" name="Fluid" type="fluid">
<k>1000000.0</k>
<rho>1.0</rho>
<viscous type="Newtonian">
<mu>0.01</mu>
<kappa>0</kappa>
</viscous>
</material>
</Material>
<Geometry>
<Nodes>
<node id="1">0.0, 0.0, 0.0</node>
<node id="2">1.0, 0.0, 0.0</node>
<node id="3">1.0, 1.0, 0.0</node>
<node id="4">0.0, 1.0, 0.0</node>
<node id="5">2.0, 0.0, 0.0</node>
<node id="6">2.0, 1.0, 0.0</node>
<node id="7">0.0, 0.0, 1.0</node>
<node id="8">1.0, 0.0, 1.0</node>
<node id="9">1.0, 1.0, 1.0</node>
<node id="10">0.0, 1.0, 1.0</node>
<node id="11">2.0, 0.0, 1.0</node>
<node id="12">2.0, 1.0, 1.0</node>
</Nodes>
<Elements type="hex8" mat="1" elset="Fluid">
<elem id="1">1,2,3,4,7,8,9,10</elem>
<elem id="2">2,5,6,3,8,11,12,9</elem>
</Elements>
<NodeSet name="inlet"><node id="1"/><node id="4"/><node id="7"/><node id="10"/></NodeSet>
<NodeSet name="outlet"><node id="5"/><node id="6"/><node id="11"/><node id="12"/></NodeSet>
<NodeSet name="wall_bottom"><node id="1"/><node id="2"/><node id="5"/><node id="7"/><node id="8"/><node id="11"/></NodeSet>
<NodeSet name="wall_top"><node id="4"/><node id="3"/><node id="6"/><node id="10"/><node id="9"/><node id="12"/></NodeSet>
<NodeSet name="wall_front"><node id="1"/><node id="2"/><node id="5"/><node id="4"/><node id="3"/><node id="6"/></NodeSet>
<NodeSet name="wall_back"><node id="7"/><node id="8"/><node id="11"/><node id="10"/><node id="9"/><node id="12"/></NodeSet>
</Geometry>
<Boundary>
<bc type="prescribed fluid velocity" node_set="inlet">
<dof>x</dof>
<value lc="1">0.1</value>
<relative>0</relative>
</bc>
<bc type="zero fluid pressure" node_set="outlet"/>
<bc type="zero fluid velocity" node_set="wall_bottom"><x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof></bc>
<bc type="zero fluid velocity" node_set="wall_top"><x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof></bc>
<bc type="zero fluid velocity" node_set="wall_front"><z_dof>1</z_dof></bc>
<bc type="zero fluid velocity" node_set="wall_back"><z_dof>1</z_dof></bc>
</Boundary>
<LoadData>
<loadcurve id="1">
<loadpoint>0.0, 0.0</loadpoint>
<loadpoint>1.0, 0.1</loadpoint>
</loadcurve>
</LoadData>
<Output>
<plotfile type="vtk">
<var type="fluid velocity"/>
<var type="fluid pressure"/>
</plotfile>
</Output>
</febio_spec>
