  "verification_fixtures": [
    {
      "id": "VF1",
      "description": "Exact byte-identical span found once in source text.",
      "source_text": "The measured conversion efficiency was 0.42 ± 0.03 under standard test conditions, with the facility reporting values since 2019.",
      "span": "0.42 ± 0.03",
      "occurrence_index": 0,
      "expected_verdict": "SPAN_VERIFIED",
      "expected_occurrences": 1
    },
    {
      "id": "VF2",
      "description": "Span absent from source text must yield SPAN_NOT_FOUND, never a fuzzy or case-insensitive match (Constitution Article II).",
      "source_text": "The measured conversion efficiency was 0.42 ± 0.03 under standard test conditions.",
      "span": "0.55 ± 0.02",
      "occurrence_index": 0,
      "expected_verdict": "SPAN_NOT_FOUND",
      "expected_occurrences": 0
    },
    {
      "id": "VF3",
      "description": "Byte-exact matching only: a whitespace-mutated span must NOT match (no fuzzy matching, no normalization drift at the binding stage).",
      "source_text": "The measured conversion efficiency was 0.42 ± 0.03 under standard test conditions.",
      "span": "0.42  ±  0.03",
      "occurrence_index": 0,
      "expected_verdict": "SPAN_NOT_FOUND",
      "expected_occurrences": 0
    },
    {
      "id": "VF4",
      "description": "Span occurring twice: explicit index resolves; out-of-range index is recorded as such; missing index with multiple occurrences is ambiguous and must be recorded, never silently first-matched.",
      "source_text": "Yield improved to 0.42 in the first run and stabilized at 0.42 in the second run.",
      "span": "0.42",
      "occurrence_index": 1,
      "expected_verdict": "SPAN_VERIFIED",
      "expected_occurrences": 2
    },
    {
      "id": "VF5",
      "description": "Out-of-range index with known occurrences.",
      "source_text": "Yield improved to 0.42 in the first run and stabilized at 0.42 in the second run.",
      "span": "0.42",
      "occurrence_index": 5,
      "expected_verdict": "SPAN_INDEX_OUT_OF_RANGE",
      "expected_occurrences": 2
    },
    {
      "id": "VF6",
      "description": "Multiple occurrences with no index chosen: ambiguity is recorded, never silently resolved.",
      "source_text": "Yield improved to 0.42 in the first run and stabilized at 0.42 in the second run.",
      "span": "0.42",
      "occurrence_index": null,
      "expected_verdict": "SPAN_AMBIGUOUS_REQUIRES_INDEX",
      "expected_occurrences": 2
    }
  ]
}
