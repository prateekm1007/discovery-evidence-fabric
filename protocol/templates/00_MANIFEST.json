{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_template": "MANIFEST.json — must be present at root of every INVENTION_XXX/ folder",
  "_purpose": "Lists every artifact in the invention package with its SHA256 hash. Preflight verifies every listed hash matches the file on disk.",
  "_required_by": "INVENTION_PROTOCOL_V1 Section 6",

  "protocol": "INVENTION_PROTOCOL_V1",
  "invention_id": "<COMPANY>_INVENTION_<NNN>_V<M>",
  "portfolio_position": "<COMPANY> Position <N> of 10",
  "buyer": "<target buyer name>",
  "version": "V<M>",
  "timestamp": "<ISO-8601 UTC>",

  "artifacts": [
    {
      "file": "00_MANIFEST.json",
      "sha256": "<64-char hex>",
      "stage": "manifest",
      "required": true
    },
    {
      "file": "08_LIMITATION_FREEZE.json",
      "sha256": "<64-char hex>",
      "stage": "6_limitation_freeze",
      "required": true,
      "immutable": true
    },
    {
      "file": "11_102_ATTACK/102_RESULTS.json",
      "sha256": "<64-char hex>",
      "stage": "9_102_attack",
      "required": true
    },
    {
      "file": "12_103_ATTACK/103_RESULTS.json",
      "sha256": "<64-char hex>",
      "stage": "10_103_attack",
      "required": true
    },
    {
      "file": "14_DESIGN_AROUND/design_around_results.json",
      "sha256": "<64-char hex>",
      "stage": "12_design_around",
      "required": true
    },
    {
      "file": "15_ENGINEERING_BLUEPRINT/blueprint.json",
      "sha256": "<64-char hex>",
      "stage": "13_engineering_blueprint",
      "required": true
    },
    {
      "file": "16_SIMULATION/simulation_results.json",
      "sha256": "<64-char hex>",
      "stage": "14_simulation",
      "required": true,
      "simulation_domain": "<must match an entry in the SIMULATION_DOMAIN registry>"
    },
    {
      "file": "17_MANUFACTURING/manufacturing_plan.json",
      "sha256": "<64-char hex>",
      "stage": "15a_manufacturing",
      "required": true
    },
    {
      "file": "18_REGULATORY/regulatory_pathway.json",
      "sha256": "<64-char hex>",
      "stage": "15b_regulatory",
      "required": true
    },
    {
      "file": "19_BUILD_BUY/build_vs_buy.json",
      "sha256": "<64-char hex>",
      "stage": "16_build_buy",
      "required": true
    },
    {
      "file": "20_BUYER_MEMO/buyer_memo.md",
      "sha256": "<64-char hex>",
      "stage": "17_buyer_value",
      "required": true
    },
    {
      "file": "21_EVIDENCE_LEDGER.json",
      "sha256": "<64-char hex>",
      "stage": "evidence_ledger",
      "required": true
    },
    {
      "file": "22_FINAL_ADJUDICATION.json",
      "sha256": "<64-char hex>",
      "stage": "18_adjudication",
      "required": true
    },
    {
      "file": "23_LESSONS_LEARNED.json",
      "sha256": "<64-char hex>",
      "stage": "lessons_learned",
      "required": true
    },
    {
      "file": "SHA256SUMS",
      "sha256": "<64-char hex>",
      "stage": "checksums",
      "required": true
    }
  ],

  "mandatory_artifact_check": {
    "00_MANIFEST.json": true,
    "08_LIMITATION_FREEZE.json": true,
    "11_102_ATTACK": true,
    "12_103_ATTACK": true,
    "14_DESIGN_AROUND": true,
    "15_ENGINEERING_BLUEPRINT": true,
    "16_SIMULATION": true,
    "17_MANUFACTURING": true,
    "18_REGULATORY": true,
    "19_BUILD_BUY": true,
    "20_BUYER_MEMO": true,
    "21_EVIDENCE_LEDGER.json": true,
    "22_FINAL_ADJUDICATION.json": true,
    "23_LESSONS_LEARNED.json": true,
    "SHA256SUMS": true
  },

  "missing_artifacts": [],
  "all_mandatory_artifacts_present": true
}
